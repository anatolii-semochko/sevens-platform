<div class="container mt-5">
    <div class="pt-3 mb-4 text-center">
        <h1 class="display-5">{{ 'Register'|trans }}</h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    {{ form_start(registrationForm, {'attr': {'class': 'needs-validation'}, 'novalidate': 'novalidate'}) }}

                    <div class="mb-3">
                        {{ form_row(registrationForm.email, {
                            attr: {'class': 'form-control'},
                            label_attr: {'class': 'form-label'}
                        }) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(registrationForm.plainPassword, {
                            label: 'Password',
                            attr: {'class': 'form-control'},
                            label_attr: {'class': 'form-label'}
                        }) }}
                    </div>

                    <div class="form-check mb-4">
                        {{ form_row(registrationForm.agreeTerms, {
                            label_attr: {'class': 'form-check-label'},
                            attr: {'class': 'form-check-input'}
                        }) }}
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">{{ 'Register'|trans }}</button>

                    <div class="text-center">
                        <p class="mb-0 text-muted">{{ 'Already have an account?'|trans }}</p>
                        <a href="{{ path('app_login') }}" class="text-decoration-none">{{ 'Sign in here'|trans }}</a>
                    </div>

                    {{ form_end(registrationForm) }}
                </div>
            </div>
        </div>
    </div>
</div>

