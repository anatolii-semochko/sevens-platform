<div class="container mt-5">
    <div class="pt-3 mb-4 text-center">
        <h1 class="display-5">{{ 'Sign In'|trans }}</h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form method="post">
                        {% if error %}
                            <div class="alert alert-danger mb-4">{{ data.error.messageKey|trans(data.error.messageData, 'security') }}</div>
                        {% endif %}

                        {% if app.user %}
                            <div class="alert alert-info mb-4">
                                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}" class="text-decoration-none">Logout</a>
                            </div>
                        {% endif %}

                        <div class="mb-3">
                            <label for="inputEmail" class="form-label">{{ 'Email'|trans }}</label>
                            <input type="email" value="{{ data.last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                        </div>

                        <div class="mb-4">
                            <label for="inputPassword" class="form-label">{{ 'Password'|trans }}</label>
                            <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        {#
                            <div class="form-check mb-3">
                                <input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input">
                                <label for="remember_me" class="form-check-label">Remember me</label>
                            </div>
                        #}

                        <button class="btn btn-primary w-100 mb-3" type="submit">
                            {{ 'Sign In'|trans }}
                        </button>

                        <div class="text-center mb-3">
                            <div class="d-flex align-items-center">
                                <hr class="flex-grow-1">
                                <span class="px-3 text-muted small">{{ 'Or continue with'|trans }}</span>
                                <hr class="flex-grow-1">
                            </div>
                        </div>

                        <a href="{{ path('connect_facebook_start') }}" class="btn btn-outline-primary w-100 mb-3 d-flex align-items-center justify-content-center">
                            <svg class="me-2" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                            </svg>
                            {{ 'Continue with Facebook'|trans }}
                        </a>

                        <div class="text-center">
                            <p class="mb-0 text-muted">{{ 'Don\'t have an account?'|trans }}</p>
                            <a href="{{ path('app_register') }}" class="text-decoration-none">{{ 'Register here'|trans }}</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
