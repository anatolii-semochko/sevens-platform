<section class="single-gallery-section">
    <div class="gallery-wrapper">
        <h2 class="section-title">{{ title }}</h2>
        <div class="scroll-gallery">
            {% for m in materials|slice(0, 50) %}
                <a href="{{ path('material_page', {'_locale': app.request.locale, token: m.getToken()}) }}">
                    <img src="{{ global.path.materials }}/{{ m.getLogo() }}" alt="{{ m.getTitle }}" />
                </a>
            {% endfor %}
        </div>
    </div>
</section>
