<main class="mp-page">
    <div class="container">
        <h3 class="text-center p-3">My materials</h3>

        {% if data.materials is empty %}
            <p class="text-center mb-4">You have no materials yet.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-4">
                    <thead>
                        <tr>
                            <th>Logo</th>
                            <th class="d-none d-lg-table-cell text-break">Token</th>
                            <th>Material</th>
                            <th>Price</th>
                            <th class="d-none d-lg-table-cell text-break">Created</th>
                            <th>Views</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for material in data.materials %}
                            <tr>
                                <td>
                                    {% if material.logo %}
                                        <img src="{{ material.logo|cdn_url }}" alt="Logo" style="width: 50px; height: 50px; object-fit: cover;">
                                    {% else %}
                                        <div style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                            <span>No logo</span>
                                        </div>
                                    {% endif %}
                                </td>
                                <td class="d-none d-lg-table-cell text-break small">{{ material.token }}</td>
                                <td>
                                    <a href="{{ path('material_page', {'_locale': app.request.locale, token: material.getToken()}) }}">
                                        {% if material.title %}
                                            {{ material.title }}
                                        {% else %}
                                            <span class="text-danger">No title</span>
                                        {% endif %}
                                    </a>
                                </td>
                                <td class="text-nowrap">
                                    {% if material.price and material.price > 0 %}
                                        {{ material.price }} <span class="fst-italic">SOL</span>
                                    {% endif %}
                                </td>
                                <td class="d-none d-lg-table-cell text-break">{{ material.createdAt|date('d.m.Y') }}</td>
                                <td class="text-center">{{ material.viewCount }}</td>
                                <td>
                                    {% if material.isActive %}
                                        <span class="badge bg-success">Active</span>
                                    {% else %}
                                        <span class="badge bg-danger">Inactive</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('material_manage_one', {'token': material.token}) }}" class="btn btn-primary">Manage</a>
                                </td>
                                <td>
                                    <button class="btn btn-primary download-container-btn" data-token="{{ material.token }}">
                                        Container download
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
        <h5 class="text-center mb-3">
            You can add materials published on the site to your personal list if you have a token that represents them.
        </h5>
        <a class="btn btn-primary w-100 p-3 mb-4 fs-5" href="{{ path('material_claim') }}">
            Claim materials belongs your tokens in the wallet
        </a>
    </div>
</main>
