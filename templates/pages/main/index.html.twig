<div class="main-content main-gallery-section flex-grow-1">
    <div class="main-gallery-wrapper" id="gallery">
       {% for material in data.materials %}
           <a class="sevens-card sevens-card-hover-transform" href="{{ path('material_page', {'_locale': app.request.locale, token: material.getToken()}) }}">
               <img src="{{ global.path.materials }}/{{ material.getLogo() }}" alt="${item.title}">
               <div class="sevens-card-body">
                   <div class="sevens-card-title">{{ material.getTitle() }}</div>
                   <div class="sevens-card-description">{{ material.getDescription() }}</div>
               </div>
           </a>
       {% endfor %}
    </div>
</div>
