<div class="main-content row justify-content-center mt-3 mb-3">
    <div class="col-12 col-lg-6">
        <h1 class="text-center mb-4">Create Token and publish material</h1>
        {% include 'pages/create-token-material/templates/create-type-selector.html.twig' %}
        <h5 class="text-justify ti-4 lh-base lh-lg-base">
            Create a public token and publish your digital data.
            The data will be accessible to anyone,
            but you will be able to prove your intellectual property rights to it using the token in your wallet.
