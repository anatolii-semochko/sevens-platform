<div class="flex-grow-1 pictures-container">
    <div class="gallery-wrapper" id="gallery">
       {% for material in materials %}
           <a class="card" href="/materials/{{ material.getToken() }}">
               <img src="/uploads/materials/{{ material.getLogo() }}" alt="${item.title}">
               <div class="card-body">
                   <div class="card-title">{{ material.getTitle() }}</div>
                   <div class="card-description">material.getDescription()</div>
               </div>
           </a>
       {% endfor %}
    </div>
</div>
