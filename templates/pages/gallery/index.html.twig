<div class="gallery-wrapper" id="gallery">
   {% for material in data.materials %}
       <a class="card card-hover-transform" href="{{ path('material_page', {'_locale': app.request.locale, token: material.getToken()}) }}">
           <img src="{{ global.path.materials }}/{{ material.getLogo() }}" alt="${item.title}">
           <div class="card-body">
               <div class="card-title">{{ material.getTitle() }}</div>
               <div class="card-description">material.getDescription()</div>
           </div>
       </a>
   {% endfor %}
</div>
