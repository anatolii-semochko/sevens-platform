<div class="mp-media">
    {% set imageFiles = [] %}
    {% if data.material.getGalleryImages() %}
        {% for file in data.material.getGalleryImages() %}
            {% if file.type|lower in ['png', 'jpg', 'jpeg', 'gif', 'webp'] %}
                {% set imageFiles = imageFiles|merge([file]) %}
            {% endif %}
        {% endfor %}
    {% endif %}

    {% if imageFiles|length > 0 %}
    <div class="mp-thumbs">
        <div class="mp-thumb">
            <img src="{{ data.material.getLogo()|cdn_url ?? (global.path.materials ~ '/' ~ data.material.getLogo()) }}" alt="{{ data.material.getTitle }}" />
        </div>
        {% for file in imageFiles %}
            <div class="mp-thumb">
                <img src="{{ file.url }}" alt="{{ data.material.getTitle }}" />
            </div>
        {% endfor %}
    </div>
    {% endif %}
    <div class="mp-carousel">
        <img src="{{ data.material.getLogo()|cdn_url ?? (global.path.materials ~ '/' ~ data.material.getLogo()) }}" alt="{{ data.material.getTitle }}" />
    </div>
</div>
