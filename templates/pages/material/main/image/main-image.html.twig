<div class="mp-media">
    {% if data.material.getGalleryImages() and data.material.getGalleryImages()|length > 0 %}
    <div class="mp-thumbs">
        <div class="mp-thumb">
            <img src="{{ global.path.materials }}/{{ data.material.getLogo() }}" alt="{{ data.material.getTitle }}" />
        </div>
        {% for file in data.material.getGalleryImages() %}
            <div class="mp-thumb">
                <img src="{{ file.url ?? (global.path.materials ~ '/' ~ file.name) }}" alt="{{ data.material.getTitle }}" />
            </div>
        {% endfor %}
    </div>
    {% endif %}
    <div class="mp-carousel">
        <img src="{{ global.path.materials }}/{{ data.material.getLogo() }}" alt="{{ data.material.getTitle }}" />
    </div>
</div>
