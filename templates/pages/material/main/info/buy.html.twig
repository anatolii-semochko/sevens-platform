{% if data.material.getPrice() %}
<div class="mp-buy">
    <button class="mp-buy-btn" id="buyTokenBtn">Buy Now</button>
    <div class="mp-price">{{ data.material.getPrice() }} SEVENS</div>
</div>
<div id="buyTokenForm"
     data-token="{{ data.material.token }}"
     data-is-my-material="{% if app.user and data.material.getUser() and app.user.id == data.material.getUser().getId() %}true{% else %}false{% endif %}"
></div>
{% else %}
    <h3 class="text-primary mt-3">Token is not for sale</h3>
{% endif %}
