{% if data.material.getPrice() %}
<div class="mp-buy">
    <button class="mp-buy-btn" id="buyTokenBtn">Buy Now</button>
    <div class="mp-price">{{ data.material.getPrice() }} SEVENS</div>
</div>
<div id="buyTokenForm"
     data-token="{{ data.material.token }}"
     data-is-my-material="{% if app.user.id == data.material.getAuthor().getId() %}true{% else %}false{% endif %}"
></div>
{% endif %}
