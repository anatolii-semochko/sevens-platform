<div class="mp-author">

    <!-- // assets/img/avatar.png -->
    <img src="assets/img/logo-sample.svg" alt="avatar" style="width:40px;height:40px;border-radius:50%;">
    <span class="mp-username">@{{ data.material.getAuthor().getFirstName() }} {{ data.material.getAuthor().getLastName() }}</span>
</div>

<h1 class="mp-title">{{ data.material.getTitle }}</h1>

<div class="mp-info-header">
    <h3 class="mp-section-title">Token Information</h3>
    <span class="mp-status">On Sale</span>
</div>

<div class="mp-info-card">
    <div class="mp-row">
        <div class="mp-label">Token<br>Description:</div>
        <div class="mp-value">
            {{ data.material.getDescription() }}
        </div>
    </div>

    <div class="mp-row">
        <div class="mp-label">Created on:</div>
        <div class="mp-value">{{ data.material.getCreatedAt()|date('F j, Y') }}</div>
    </div>

    <div class="mp-row">
        <div class="mp-label">Blockchain:</div>
        <div class="mp-value">sevenscoin</div>
    </div>

    <div class="mp-row">
        <div class="mp-label">Token ID:</div>
        <div class="mp-value">{{ data.material.getToken() }}</div>
    </div>

    <div class="mp-row">
        <div class="mp-label">Smart contract<br>address:</div>
        <div class="mp-value">{{ data.material.getContractAddress() ?? 'Not available' }}</div>
    </div>
</div>

<div class="mp-proof">
    <i class="bi bi-patch-check"></i>
    <span>Authenticity and Blockchain Proof</span>
</div>

{% include 'pages/material/main/info/buy.html.twig' %}
