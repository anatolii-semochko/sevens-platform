<div class="mp-user">
    <!-- Avatar temporarily disabled - no avatars available yet -->
    <!-- <img src="assets/img/logo-sample.svg" alt="avatar" style="width:40px;height:40px;border-radius:50%;"> -->
    <span class="mp-username">
        {% if data.material.getUser() %}
            @{{ data.material.getUser().getFirstName() ?? 'Unknown' }} {{ data.material.getUser().getLastName() ?? 'Publisher' }}
        {% endif %}
    </span>
</div>

<h1 class="mp-title">{{ data.material.getTitle }}</h1>

<div class="mp-info-card">
    <div class="mp-row">
        <div class="mp-label">Token Public Key:</div>
        <div class="mp-value ps-2">{{ data.material.getToken() }}</div>
    </div>
    <div class="mp-row">
        <div class="mp-label">Token Author:</div>
        <div class="mp-value ps-2">{{ data.material.getTokenData().getAuthor() }}</div>
    </div>
    <div class="mp-row">
        <div class="mp-label">Token Description:</div>
        <div class="mp-value ps-2">{{ data.material.getTokenData().getDescription() }}</div>
    </div>
    <div class="mp-row">
        <div class="mp-label">Token Mint:</div>
        <div class="mp-value ps-2">{{ data.material.getTokenData().getMintingTimeText() }}</div>
    </div>
    <div class="mp-row">
        <div class="mp-label">Published on:</div>
        <div class="mp-value ps-2">{{ data.material.getCreatedAt()|date('F j, Y') }}</div>
    </div>
    <div class="mp-row">
        <div class="mp-label">Blockchain:</div>
        <div class="mp-value ps-2">sevenscoin</div>
    </div>
</div>

<a href="{{ data.material.tokenData.getBlockchainTokenUrl() }}"
   target="_blank"
   rel="noopener"
>
    Check token in blockchain
</a>

{% if data.material.hasBlockchainProof() %}
<div class="mp-proof">
    <i class="bi bi-patch-check"></i>
    <span>Authenticity and Blockchain Proof</span>
</div>
{% endif %}

<a href="{{ path('material_claim', {'_locale': app.request.locale}) }}" class="btn btn-outline-secondary w-100 mt-3">
    Claim material
</a>

{% include 'pages/material/main/info/buy.html.twig' %}
