<div class="">
    <div class="pt-3 mb-4">
        <h1>{{ 'User'|trans }}</h1>
    </div>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Welcome, {{ data.user.email }}</h4>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title mb-4">Your Profile Information</h5>

                        <dl class="row">
                            <dt class="col-sm-4">Email:</dt>
                            <dd class="col-sm-8">{{ data.user.email }}</dd>

                            {% if data.user.fullName is defined %}
                                <dt class="col-sm-4">Full Name:</dt>
                                <dd class="col-sm-8">{{ data.user.fullName }}</dd>
                            {% endif %}

                            <dt class="col-sm-4">Member Since:</dt>
                            <dd class="col-sm-8">{{ data.user.createdAt|date('F j, Y') }}</dd>
                        </dl>

                        <div class="mt-4 d-flex justify-content-between">
                            <a href="{{ path('app_edit_profile') }}" class="btn btn-outline-primary">
                                Edit Profile
                            </a>
                            <a href="{{ path('app_logout') }}" class="btn btn-danger">
                                Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


