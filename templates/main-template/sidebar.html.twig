<aside id="sidebar" class="sidebar bg-light p-3">
    <ul class="list-unstyled">
        <li class="mb-0">
            <a href="{{ path('home_page', {'_locale': app.request.locale}) }}" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                <i class="bi bi-house"></i><strong class="text-uppercase text-decoration-none">{{ 'Home'|trans }}</strong>
            </a>
        </li>

        <li class="mb-3">
            <a href="{{ path('help_index', {'_locale': app.request.locale}) }}" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                <i class="bi bi-question-lg"></i><strong class="text-uppercase text-decoration-none">{{ 'Help'|trans }}</strong>
            </a>
        </li>

        <li class="mb-3">
            <a href="#" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                <i class="bi bi-funnel"></i><strong class="text-uppercase text-decoration-none">Filter</strong>
            </a>
            <ul class="list-unstyled ms-4 mt-2">
                <li><a href="#" class="d-block py-1 text-decoration-none">New Products</a></li>
                <li><a href="#" class="d-block py-1 text-decoration-none">Popular Products</a></li>
                <li><a href="#" class="d-block py-1 text-decoration-none">New Auction</a></li>
                <li><a href="#" class="d-block py-1 text-decoration-none">Popular Auction</a></li>
            </ul>
        </li>

        <li class="mb-3">
            <a href="#" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                <i class="bi bi-cash"></i><strong class="text-uppercase text-decoration-none">Price</strong>
            </a>
            <ul class="list-inline ms-4 mt-2">
                <li class="list-inline-item"><a href="#" class="text-decoration-none">Low</a></li>
                <li class="list-inline-item"><a href="#" class="text-decoration-none">High</a></li>
                <li class="list-inline-item"><a href="#" class="text-decoration-none">All</a></li>
            </ul>
        </li>

        <li class="mb-3">
            <a href="#" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                <i class="bi bi-grid"></i><strong class="text-uppercase text-decoration-none">Domain</strong>
            </a>
            <ul class="list-unstyled ms-4 mt-2">
                {% for category in global.categories %}
                    <li>
                        <a href="#" class="d-block py-1 text-decoration-none"><b>{{ category.getNameTranslation() }}</b></a>
                        <ul class="ms-3">
                            {% for subCategory in category.getChildren() %}
                                <li>
                                    <a href="#" class="d-block py-1 small text-decoration-none">
                                        {{ subCategory.getNameTranslation() }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ul>
        </li>

    </ul>
</aside>
