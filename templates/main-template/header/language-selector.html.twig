<div class="d-flex align-items-center">
    <div class="dropdown">
        <a href="#" role="button" id="languageDropdown" data-bs-toggle="dropdown">
            <img src="{{ asset('build/images/language-flags/' ~ current_locale ~ '.png') }}"
                 title="{{ current_locale|upper }}"
                 alt="{{ current_locale|upper }}"
                 height="20"
                 style="border-radius: 3px;"
            >
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
            {% set current_path = app.request.pathInfo %}
            {% for lang in global.languages %}
                <li class="mx-4 my-3">
                    {% set has_lang_prefix = current_path matches '/^\\/[a-z]{2}(\\/|$)/' %}
                    {% set new_path = has_lang_prefix
                        ? '/' ~ lang.code ~ current_path|slice(3)
                        : '/' ~ lang.code ~ current_path
                    %}
                    <a class="dropdown-item d-flex align-items-center gap-2{% if current_locale == lang.code %} active{% endif %}"
                       href="{{ new_path }}">
                        <img src="/build/images/language-flags/{{ lang.code }}.png"
                             alt="{{ lang.name }}"
                             height="20"
                             style="border-radius: 3px;"
                        >
                        {{ lang.name }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
