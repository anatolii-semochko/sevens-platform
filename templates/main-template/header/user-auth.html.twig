{% if app.user %}
    <div data-user="{{ {
        'email': app.user.email,
        'id': app.user.id,
        'createdAt': app.user.createdAt|date('c'),
        'profileUrl': path('user_index')
    }|json_encode|e('html_attr') }}"></div>
{% else %}
    <div data-register-url="{{ path('app_register', {'_locale': app.request.locale}) }}"></div>
{% endif %}
