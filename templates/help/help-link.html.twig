<div class="help-link">
    <a href="{{
        help.url ? path('help_page', {'_locale': app.request.locale, 'slugPath': help.pageUrl}) : '#'
    }}" class="toggle-help">
        {{ help.title }} <i class="bi bi-question-circle px-1"></i>
    </a>
    <p>{{ help.shortDescription }}{% if help.url %} <a href="#" class="read-more" target="_blank">Read more</a>{% endif %}</p>
</div>
