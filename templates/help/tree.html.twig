<ul class="ps-3">
    {% for node in nodes %}
        <li class="mb-2">
            <a href="{{ path('help_page', {'_locale': app.request.locale, 'slugPath': node.pageUrl}) }}">
                {{ node.title }}
            </a>
            {% if node.shortDescription %}
                <div class="text-muted small">{{ node.shortDescription }}</div>
            {% endif %}

            {% if node.children is not empty %}
                {% include 'help/tree.html.twig' with {'nodes': node.children} %}
            {% endif %}
        </li>
    {% endfor %}
</ul>
