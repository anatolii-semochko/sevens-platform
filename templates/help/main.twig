
<div class="flex-grow-1 pictures-container mb-5">
    <div class="">

        <div class="mb-4">
            {% for breadCrumb in help.getBreadcrumbs() %}
                {% if breadCrumb.url is defined %}
                    / <a href="#">{{ breadCrumb.title }}</a>
                {% else %}
                    / {{ breadCrumb.title }}
                {% endif %}
            {% endfor %}
        </div>

        <h1>{{ help.getName() }}</h1>
        <h2>{{ help.getContents()[0].getTitle() }}</h2>
        <h3>{{ help.getContents()[0].getShortDescription() }}</h3>
        <p>{{ help.getContents()[0].getDescription() }}</p>
        {% for subHelp in help.getChildren() %}
            <div class="mt-4">
                <div class=""><h2>{{ subHelp.getName() }}</h2></div>
                <div class="">{{ subHelp.getContents()[0].getShortDescription() }}</div>
                <div>
                    <a class="" href="{{ path('help_page', {'_locale': app.request.locale, slugPath: subHelp.getPageUrl()}) }}">
                        Read More
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
