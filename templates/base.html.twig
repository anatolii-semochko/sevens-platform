<!DOCTYPE html>
<html lang="{{ current_locale }}">
    <head>
        <title>{{ global.seo.getTitle() }}</title>
        <meta name="description" content="{{ global.seo.getDescription() }}"/>
        <meta name="csrf-token" content="{{ csrf_token('authenticate') }}"/>
        <link rel="canonical" href="{{ global.canonicalUrl }}"/>
    {% for alternate in global.seoAlternates %}
    <link rel="alternate" href="{{ alternate.href }}" hreflang="{{ alternate.hreflang }}"/>
    {% endfor %}
    <link rel="alternate" href="{{ global.host }}" hreflang="x-default"/>
    {% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
    <body>
        <div>
            {% include 'main-template/header.html.twig' %}
            <div class="layout-wrapper d-flex">
                {% include 'main-template/sidebar.html.twig' %}
                <main class="main-content d-flex flex-column">
                    <div class="flex-grow-1 pictures-container">
                        {# Flash Messages #}
                        <div class="container mt-3">
                            {% for message in app.flashes('success') %}
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    {{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}
                            
                            {% for message in app.flashes('error') %}
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    {{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}
                            
                            {% for message in app.flashes('warning') %}
                                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                    {{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}
                            
                            {% for message in app.flashes('info') %}
                                <div class="alert alert-info alert-dismissible fade show" role="alert">
                                    {{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}
                        </div>
                        
                        {% include main_template with data %}
                    </div>
                    {% include 'main-template/footer.html.twig' %}
                </main>
            </div>
            <div id="wallet-panel" class="right-slide-panel"></div>
        </div>
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </body>
</html>
<script>
    window.AppConfig = {
        currentLocale: '{{ current_locale }}',
        path: {{ global.path|json_encode|raw }},
    };
</script>
