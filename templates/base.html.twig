<!DOCTYPE html>
<html lang="{{ current_locale }}">
  <head>
    <title>{{ global.seo.getTitle() }}</title>
    {% include 'main-template/service-data/seo.html.twig' %}
  </head>
  <body>
    <div id="main-body">
      {% include 'main-template/header.html.twig' %}
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        <div class="layout-wrapper">
            {% include 'main-template/sidebar.html.twig' %}
            <main class="main-container d-flex flex-column">
                {% include main_template with data %}
            </main>
            {% include 'main-template/footer.html.twig' %}
        </div>
    </div>
    {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {% endblock %}
  </body>
</html>
{% include 'main-template/service-data/js-params.html.twig' %}
