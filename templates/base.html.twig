<!DOCTYPE html>
<html lang="en">
    <head>
        <title>{{ global.seo.getTitle() }}</title>
        <meta name="description" content="{{ global.seo.getDescription() }}"/>
        <link rel="canonical" href="{{ global.canonicalUrl }}"/>
    {% for alternate in global.seoAlternates %}
    <link rel="alternate" href="{{ alternate.href }}" hreflang="{{ alternate.hreflang }}" />
    {% endfor %}
    <link rel=“alternate“ href=“{{ global.canonicalUrl }}“ hreflang=“x-default“ />
    {% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
    <body>
        <div>
            {% include 'main-template/header.twig' %}
            <div class="layout-wrapper d-flex">
                {% include 'main-template/sidebar.twig' %}
                <main class="main-content d-flex flex-column">
                    {% include main_template with main_data %}
                    {% include 'main-template/footer.twig' %}
                </main>
            </div>
        </div>
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </body>
</html>
