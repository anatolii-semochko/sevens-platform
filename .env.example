ORGANIZATION="Your Organization"
DOMAIN=https://yourdomain.local
LOGO=https://yourdomain.local/storage/images/logo.svg

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your_symfony_app_secret_here_32_characters_long
###< symfony/framework-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> Database Settings ###
DATABASE_URL="mysql://username:password@mysql:3306/database_name"
MYSQL_DATABASE=database_name
###< Database Settings ###

###> Folders Settings ###
PUBLIC_FOLDER=/app/public
PATH_TRANSLATIONS=/storage/files/translations
PATH_HELP_TRANSLATIONS=/storage/files/help-translations
PATH_LANGUAGE_FLAGS=/storage/images/language-flags
PATH_CATEGORY_LOGOS=/storage/images/category-logos
PATH_MATERIALS=/storage/files/materials
###< Folders Settings ###

###> Blockchain Settings ###
# ANCHOR_PROVIDER_URL=http://localhost:8899
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
HDT_IDL_PATH=https://yourdomain.local/storage/files/token.json
HDT_MANAGEMENT_IDL_PATH=https://yourdomain.local/storage/files/token_management.json
COLLECTION_IPFS_JSON=https://gateway.pinata.cloud/ipfs/your_ipfs_hash_here
COLLECTION_NAME="Your Collection Name"
COLLECTION_MINT_PUBLIC_KEY=your_collection_mint_public_key_here
COLLECTION_URL=https://explorer.solana.com/address/your_collection_mint_public_key_here?cluster=devnet
TOKEN_BLOCKCHAIN_URL=https://explorer.solana.com/address/{tokenPublicKey}?cluster=devnet
###< Blockchain Settings ###

###> AWS S3 Settings ###
AWS_S3_BUCKET_URL=https://your-bucket-name.s3.amazonaws.com
# LocalStack configuration (for development)
AWS_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_USE_PATH_STYLE_ENDPOINT=true

# S3 Buckets
AWS_S3_MATERIALS_BUCKET=your-materials-bucket
AWS_S3_PRESIGNED_EXPIRATION=3600
AWS_S3_PUBLIC_ENDPOINT=https://yourdomain.local:8444/s3

# CDN Configuration
# Development: Use nginx proxy to LocalStack
# Production: Use Cloudflare proxy to real S3 (e.g., https://files.yourdomain.com)
CDN_BASE_URL=https://yourdomain.local:8444/s3/your-materials-bucket
CDN_ENABLED=true

# Lambda Configuration
AWS_LAMBDA_MATERIAL_VALIDATOR_FUNCTION=material-validator
AWS_LAMBDA_TIMEOUT=300
###< AWS S3 Settings ###

###> facebook oauth ###
FACEBOOK_CLIENT_ID=your_facebook_client_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_here
###< facebook oauth ###

###> node server ###
NODE_ENV=development
NONCE_EXPIRATION_MIN=15
NODE_SERVER_PORT=3000
NODE_SERVER_BASE_URL=http://platform-node-server:3000
NODE_SERVER_HDT_IDL_PATH=/app/public/storage/files/token.json
NODE_SERVER_HDT_MANAGEMENT_IDL_PATH=/app/public/storage/files/token_management.json
NODE_SYMFONY_INTERNAL_URL=https://web:443
NODE_TLS_REJECT_UNAUTHORIZED=0
###< node server ###

###> websocket configuration ###
# WebSocket URL for solana-usd rate (node-server connects as client to this)
EXCHANGER_WEBSOCKET_URL=wss://stream.binance.com:9443/ws/solusdt@ticker
###< websocket configuration ###

###> publication ###
# Allowment period for publishing material after token mint without wallet confirm signature.
# After that period user can publish only after wallet comfirmation.
ALLOWED_PUBLISHING_TIME_WITHOUT_SIGNATURE_MINUTES=15
# Max container size for decompressing to the memory. Bigger size we decompress to the disk.
BROWSER_FILE_MEMORY_DECOMPRESSION_LIMIT=104857600
###< publication ###

###> Webpack ###
WEBPACK_DEV_SERVER_ALLOWED_HOSTS=yourdomain.local,localhost,.local
###< Webpack ###

###> OpenAI ###
OPENAI_API_KEY=your_openai_api_key_here
###< OpenAI ###