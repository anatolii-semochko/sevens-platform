{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["assets/*"],
      "@js/*": ["assets/js/*"],
      "@css/*": ["assets/css/*"],
    }
  },
  "include": [
    "assets/**/*",
    "assets/types/**/*",
  ]
}
