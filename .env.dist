###> Database Settings ###
DATABASE_URL="mysql://app:secret@mysql:3306/sevens-time"
###< Database Settings ###

###> Folders Settings ###
PUBLIC_FOLDER=/app/public
PATH_TRANSLATIONS=/storage/files/translations
PATH_HELP_TRANSLATIONS=/storage/files/help-translations
PATH_LANGUAGE_FLAGS=/storage/images/language-flags
PATH_CATEGORY_LOGOS=/storage/images/category-logos
PATH_MATERIALS=/storage/files/materials
###< Folders Settings ###

###> Blockchain Settings ###
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
SEVENS_TOKEN_IDL_PATH=https://sevenstime.local/storage/files/sevens_token.json
SEVENS_TOKEN_MANAGEMENT_IDL_PATH=https://sevenstime.local/storage/files/sevens_token_management.json
COLLECTION_IPFS_JSON=https://gateway.pinata.cloud/ipfs/bafkreibjkz5xx2zgkjv6vmjcsrbrd572whomtfccc5xbvbilx2oomnklrm
COLLECTION_NAME=SevensTime
COLLECTION_MINT_PUBLIC_KEY=91G9KcYSU7sGvpDz8LiaqqwceHB5RqkbHgtM7iZzqATd
COLLECTION_URL=https://explorer.solana.com/address/91G9KcYSU7sGvpDz8LiaqqwceHB5RqkbHgtM7iZzqATd?cluster=devnet
TOKEN_BLOCKCHAIN_URL=https://explorer.solana.com/address/{tokenPublicKey}?cluster=devnet
###< Blockchain Settings ###

###> AWS S3 Settings ###
# LocalStack configuration (for development)
AWS_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_USE_PATH_STYLE_ENDPOINT=true

# S3 Buckets
AWS_S3_MATERIALS_BUCKET=sevenstime-materials
AWS_S3_PRESIGNED_EXPIRATION=3600
AWS_S3_PUBLIC_ENDPOINT=https://sevenstime.local:8444/s3

# CDN Configuration
# Development: Use nginx proxy to LocalStack
# Production: Use Cloudflare proxy to real S3 (e.g., https://files.sevenstime.com)
CDN_BASE_URL=https://sevenstime.local:8444/s3/sevenstime-materials
CDN_ENABLED=true

# Lambda Configuration
AWS_LAMBDA_MATERIAL_VALIDATOR_FUNCTION=material-validator
AWS_LAMBDA_TIMEOUT=300
###< AWS S3 Settings ###

###> facebook oauth ###
FACEBOOK_CLIENT_ID=clientID
FACEBOOK_CLIENT_SECRET=clientSecret
###< facebook oauth ###

###> node server ###
NODE_ENV=development
NONCE_EXPIRATION_MIN=15
NODE_SERVER_PORT=3000
NODE_SERVER_BASE_URL=http://sevenstime-node-server:3000
NODE_SERVER_SEVENS_TOKEN_IDL_PATH=/app/public/storage/files/sevens_token.json
NODE_SERVER_SEVENS_TOKEN_MANAGEMENT_IDL_PATH=/app/public/storage/files/sevens_token_management.json
###< node server ###

###> websocket configuration ###
# WebSocket URL for solana-usd rate (node-server connects as client to this)
EXCHANGER_WEBSOCKET_URL=wss://stream.binance.com:9443/ws/solusdt@ticker
###< websocket configuration ###

###> publication ###
# Allowment period for publishing material after token mint without wallet confirm signature.
# After that period user can publish only after wallet comfirmation.
ALLOWED_PUBLISHING_TIME_WITHOUT_SIGNATURE_MINUTES=15
# Max container size for decompressing to the memory. Bigger size we decompress to the disk.
BROWSER_FILE_MEMORY_DECOMPRESSION_LIMIT=104857600
###< publication ###

###> Webpack ###
WEBPACK_DEV_SERVER_ALLOWED_HOSTS=sevenstime.local,localhost,.local
###< Webpack ###
